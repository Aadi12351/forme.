# Start with npm start. server.js loads .env if present.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
# preview | demo (local only) | test (Razorpay test keys) | live
CHECKOUT_MODE=preview
# Replace these before production; local .env was generated privately.
ADMIN_PASSWORD=
SESSION_SECRET=
# Production canonical origin; use HTTPS. Leave empty for local development.
APP_URL=
# Optional alternate persistent directory
STORE_DATA_DIR=
# Only enable behind a private reverse proxy that replaces forwarding headers.
TRUST_PROXY=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
META_ACCESS_TOKEN=
META_PIXEL_ID=
# Select a currently supported version from Meta documentation.
META_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved templates take two body text variables: order number and update type.
WHATSAPP_TEMPLATE_order_confirmation=
WHATSAPP_TEMPLATE_payment_confirmation=
WHATSAPP_TEMPLATE_order_dispatch=
WHATSAPP_TEMPLATE_tracking_information=
WHATSAPP_TEMPLATE_delivery_confirmation=
WHATSAPP_TEMPLATE_order_cancellation=
WHATSAPP_TEMPLATE_return_approved=
WHATSAPP_TEMPLATE_exchange_approved=
WHATSAPP_TEMPLATE_refund_confirmation=
