/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
/index.html
  Cache-Control: no-cache
/launch.js
  Cache-Control: no-cache
/launch.css
  Cache-Control: no-cache
